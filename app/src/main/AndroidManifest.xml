<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Bluetooth Classic / RFCOMM ===== -->
    <!-- Legacy permissions, needed up to API 30 -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!--
        Bluetooth Classic discovery on API 29-30 requires ACCESS_FINE_LOCATION
        specifically; COARSE is not sufficient there. From API 31 the app uses
        BLUETOOTH_SCAN with neverForLocation instead, which is why this is
        capped at 30.

        Lint's CoarseFineLocation check asks for COARSE alongside FINE because
        on Android 12 and above the user may grant only approximate location.
        That premise cannot hold here: maxSdkVersion caps this permission at 30,
        so on Android 12 and above the app neither requests nor holds it, and
        the partial-grant UI the rule is about does not exist on 29-30. Adding
        COARSE would declare a permission that could never enable anything.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30"
        tools:ignore="CoarseFineLocation" />

    <!-- API 31+ runtime Bluetooth permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ===== Audio ===== -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ===== Foreground services ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- No INTERNET / ACCESS_NETWORK_STATE on purpose: the product requirement is a
         Bluetooth-only transport. Do not add them. -->

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />

    <application
        android:name=".DualStreamApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DualStream">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.DualStream">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone A: RFCOMM server + decoder + mixer + AudioTrack -> A2DP headset -->
        <service
            android:name=".service.ReceiverService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|connectedDevice|microphone" />

        <!-- Phone B: AudioPlaybackCapture -> encoder -> RFCOMM client -->
        <service
            android:name=".service.TransmitterService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|connectedDevice|microphone" />

        <receiver
            android:name=".service.BtStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
